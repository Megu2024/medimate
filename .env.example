# ==============================================================================
# MEDIMATE SMART MEDICINE BOX - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the 'server/' directory (and configure 'client/.env' if needed).
# 2. Never commit actual .env files containing real secrets to version control.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Example Atlas format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/medimate?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/medimate

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_secure_secret_string_minimum_32_chars
JWT_EXPIRES_IN=7d
# 32-byte Hex string for AES-256-GCM encryption of user-stored API keys
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Gemini API (For Medical Report Analysis)
# Optional system-wide default key; users can also configure their own private key in Settings UI.
GEMINI_API_KEY=

# SMS Gateway Configuration (Twilio or compatible provider)
# If left empty, system operates in safe test/mock mode with clear UI status indicators.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Web Push Notification Keys (VAPID)
# Generated using 'npx web-push generate-vapid-keys'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@medimate.local

# File Uploads Directory
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
